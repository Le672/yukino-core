# Optional legacy environment overrides. The console is the recommended editor.
# scripts/init_instance.py generates private data/secrets.json with random tokens.
# Never commit your real .env, secrets.json, providers.json or connections.json.
YUKINO_ADMIN_PORT=18001
YUKINO_SELF_ID=
YUKINO_OWNER_ID=
YUKINO_RECEIVE_ENABLED=false
YUKINO_ONEBOT_URL=ws://127.0.0.1:3001
# Optional ChatGPT webpage bridge; not included in the core source release.
YUKINO_PROVIDER_URL=http://127.0.0.1:17656
# Docker only: UID:GID used for writable data volumes on Linux.
YUKINO_UID=10001
YUKINO_GID=10001
