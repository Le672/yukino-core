ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONPATH=/app DISPLAY=:98 NO_AT_BRIDGE=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-aiohttp python3-gi gir1.2-atspi-2.0 gir1.2-gtk-3.0 \
    at-spi2-core dbus-x11 xvfb && rm -rf /var/lib/apt/lists/*
COPY qq_desktop /app/qq_desktop
COPY scripts /app/scripts
COPY tests /app/tests
WORKDIR /app
CMD ["dbus-run-session", "--", "sh", "-c", "Xvfb :98 -screen 0 1280x800x24 -nolisten tcp & sleep 1; python3 -m unittest discover -s tests -q && python3 scripts/gtk_acceptance.py"]
