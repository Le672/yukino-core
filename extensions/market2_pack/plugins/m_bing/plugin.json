{
  "id": "m_bing",
  "name": "Bing每日原图",
  "version": "1.2.0",
  "description": "发送Bing每日壁纸原图、标题与版权说明",
  "worker": "worker.py",
  "commands": [
    "/每日壁纸"
  ],
  "config_schema": [
    {
      "key": "market",
      "type": "string",
      "label": "Bing区域",
      "default": "zh-CN",
      "options": [
        "zh-CN",
        "en-US",
        "ja-JP",
        "de-DE"
      ]
    },
    {
      "key": "network_timeout_seconds",
      "type": "integer",
      "label": "单命令联网总预算秒",
      "default": 12,
      "min": 2,
      "max": 15
    }
  ],
  "minimum_core_version": "0.8.0",
  "result_protocol": 1
}
