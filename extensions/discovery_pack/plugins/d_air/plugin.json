{
  "id": "d_air",
  "name": "城市空气质量与趋势",
  "description": "查询PM2.5、PM10和美标AQI，发送未来24小时趋势图；Open-Meteo/CAMS模型估计，不是国标AQI或监测站实测。",
  "commands": [
    "/空气质量"
  ],
  "worker": "worker.py",
  "version": "0.1.0",
  "minimum_core_version": "0.11.0",
  "result_protocol": 1,
  "config_schema": [
    {
      "key": "online_enabled",
      "type": "boolean",
      "label": "允许访问本功能公开数据源",
      "default": true
    },
    {
      "key": "network_seconds",
      "type": "integer",
      "label": "网络请求总预算（秒）",
      "default": 12,
      "min": 2,
      "max": 20
    },
    {
      "key": "cache_seconds",
      "type": "integer",
      "label": "成功结果缓存（秒，0禁用）",
      "default": 300,
      "min": 0,
      "max": 3600
    },
    {
      "key": "default_city",
      "type": "string",
      "label": "默认城市（留空时需指定）",
      "default": "",
      "max_length": 80
    }
  ]
}
