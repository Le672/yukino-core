{
  "id": "quotes",
  "name": "会话语录收藏",
  "version": "1.2.0",
  "description": "仅收录主动提供的文字，可按权限软归档",
  "worker": "worker.py",
  "commands": [
    "/语录"
  ],
  "config_schema": [
    {
      "key": "max_entries",
      "type": "integer",
      "label": "每用户活跃语录上限",
      "default": 100,
      "min": 1,
      "max": 500
    }
  ],
  "minimum_core_version": "0.8.0",
  "result_protocol": 1
}
