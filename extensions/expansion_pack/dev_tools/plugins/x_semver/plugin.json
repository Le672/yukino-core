{
  "id": "x_semver",
  "name": "语义版本比较",
  "version": "1.2.0",
  "description": "严格SemVer排序，包括预发行数字标识与构建元数据",
  "worker": "worker.py",
  "commands": [
    "/版本比较"
  ],
  "config_schema": [
    {
      "key": "max_output_chars",
      "type": "integer",
      "label": "单次回复最多字符",
      "default": 6000,
      "min": 1000,
      "max": 12000
    }
  ],
  "minimum_core_version": "0.8.0",
  "result_protocol": 1
}
