{
  "id": "x_http",
  "name": "HTTP与网站状态",
  "version": "1.2.0",
  "description": "真实检测公开HTTPS网站状态与响应头，保留HTTP状态码和MIME本地速查",
  "worker": "worker.py",
  "commands": [
    "/HTTP状态",
    "/MIME",
    "/网站状态"
  ],
  "config_schema": [
    {
      "key": "max_output_chars",
      "type": "integer",
      "label": "单次回复最多字符",
      "default": 6000,
      "min": 1000,
      "max": 12000
    },
    {
      "key": "online_enabled",
      "type": "boolean",
      "label": "允许联网查询",
      "default": true
    },
    {
      "key": "network_timeout_seconds",
      "type": "integer",
      "label": "每个数据源网络超时秒数",
      "default": 8,
      "min": 2,
      "max": 15
    },
    {
      "key": "cache_seconds",
      "type": "integer",
      "label": "归属与DNS成功结果缓存秒数",
      "default": 600,
      "min": 0,
      "max": 3600
    }
  ],
  "minimum_core_version": "0.8.0",
  "result_protocol": 1
}
