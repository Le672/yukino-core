{
  "id": "x_cron",
  "name": "Cron解释与下次时间",
  "version": "1.0.0",
  "description": "标准五字段Cron解析和有界未来触发时间计算",
  "worker": "worker.py",
  "commands": [
    "/Cron说明",
    "/Cron下次"
  ],
  "config_schema": [
    {
      "key": "utc_offset_hours",
      "type": "integer",
      "label": "显示时区UTC偏移小时",
      "default": 8,
      "min": -12,
      "max": 14
    },
    {
      "key": "result_count",
      "type": "integer",
      "label": "显示下次时间数量",
      "default": 3,
      "min": 1,
      "max": 5
    },
    {
      "key": "lookahead_days",
      "type": "integer",
      "label": "最大扫描天数",
      "default": 1096,
      "min": 1,
      "max": 1096
    },
    {
      "key": "max_output_chars",
      "type": "integer",
      "label": "单次回复最多字符",
      "default": 6000,
      "min": 1000,
      "max": 12000
    }
  ]
}
